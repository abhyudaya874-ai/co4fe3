{
  "name": "co4fe3-vscode",
  "displayName": "co4fe3",
  "description": "Coding agent on TrueForge: inline edit, a crew of subagents, per-hunk review, automatic model fallback.",
  "version": "0.1.0",
  "publisher": "co4fe3",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.cjs",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "co4fe3.inlineEdit",
        "title": "Edit selection",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.inlineCancel",
        "title": "Cancel inline edit",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.hunk.accept",
        "title": "Accept hunk",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.hunk.reject",
        "title": "Reject hunk",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.hunk.acceptAtCursor",
        "title": "Accept hunk at cursor",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.hunk.rejectAtCursor",
        "title": "Reject hunk at cursor",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.proposal.acceptAll",
        "title": "Accept all hunks",
        "category": "co4fe3",
        "icon": "$(check-all)"
      },
      {
        "command": "co4fe3.proposal.rejectAll",
        "title": "Reject all hunks",
        "category": "co4fe3",
        "icon": "$(close-all)"
      },
      {
        "command": "co4fe3.undoLast",
        "title": "Undo last applied change",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.revertTurn",
        "title": "Revert this turn's changes",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.pickModel",
        "title": "Choose models",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.cycleMode",
        "title": "Cycle mode (Agent / Ask / Plan)",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.resetStats",
        "title": "Reset model stats",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.openSession",
        "title": "Open session in TrueForge",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.startTrueForge",
        "title": "Start TrueForge in a terminal",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.dev.sampleProposal",
        "title": "Dev: sample proposal",
        "category": "co4fe3"
      },
      {
        "command": "co4fe3.dev.rank",
        "title": "Dev: rank files for a prompt",
        "category": "co4fe3"
      }
    ],
    "keybindings": [
      {
        "command": "co4fe3.inlineEdit",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorTextFocus && !co4fe3.inlineBusy"
      },
      {
        "command": "co4fe3.inlineCancel",
        "key": "escape",
        "when": "co4fe3.inlineBusy"
      },
      {
        "command": "co4fe3.hunk.acceptAtCursor",
        "key": "alt+y",
        "when": "resourceScheme == co4fe3-proposal"
      },
      {
        "command": "co4fe3.hunk.rejectAtCursor",
        "key": "alt+n",
        "when": "resourceScheme == co4fe3-proposal"
      },
      {
        "command": "co4fe3.proposal.acceptAll",
        "key": "alt+shift+y",
        "when": "resourceScheme == co4fe3-proposal"
      },
      {
        "command": "co4fe3.cycleMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "focusedView == co4fe3.panel"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "co4fe3.proposal.acceptAll",
          "when": "resourceScheme == co4fe3-proposal",
          "group": "navigation@1"
        },
        {
          "command": "co4fe3.proposal.rejectAll",
          "when": "resourceScheme == co4fe3-proposal",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "co4fe3.hunk.accept",
          "when": "false"
        },
        {
          "command": "co4fe3.hunk.reject",
          "when": "false"
        },
        {
          "command": "co4fe3.dev.sampleProposal",
          "when": "co4fe3.devMode"
        },
        {
          "command": "co4fe3.dev.rank",
          "when": "co4fe3.devMode"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "co4fe3",
          "title": "co4fe3",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "co4fe3": [
        {
          "type": "webview",
          "id": "co4fe3.panel",
          "name": "Agent"
        }
      ]
    },
    "configuration": {
      "title": "co4fe3",
      "properties": {
        "co4fe3.trueforge.url": {
          "type": "string",
          "default": "http://localhost:8790",
          "description": "TrueForge local server."
        },
        "co4fe3.trueforge.command": {
          "type": "string",
          "default": "npm run trueforge",
          "description": "Command run by 'Start TrueForge in a terminal'."
        },
        "co4fe3.models.order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Model FQNs as TrueForge lists them; the first is the primary. Empty: the first two models TrueForge lists."
        },
        "co4fe3.mode": {
          "type": "string",
          "enum": [
            "agent",
            "ask",
            "plan"
          ],
          "default": "agent",
          "markdownDescription": "Agent edits (with review); Ask and Plan are read-only. Applies to the next chat session."
        },
        "co4fe3.crew.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Let the lead agent delegate to subagents."
        },
        "co4fe3.context.packTokens": {
          "type": "number",
          "default": 6000,
          "minimum": 1000,
          "maximum": 12000
        },
        "co4fe3.latency.autoOrderInline": {
          "type": "boolean",
          "default": true,
          "description": "Order inline-edit models by measured time to first token."
        },
        "co4fe3.latency.hedgeInline": {
          "type": "boolean",
          "default": true,
          "description": "Start the next model if the first is slow to start streaming."
        },
        "co4fe3.commands.timeoutSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 5,
          "maximum": 600
        },
        "co4fe3.autoApprove.terminal": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run commands that pass the command policy without asking. Edits are always reviewed."
        }
      }
    },
    "configurationDefaults": {
      "diffEditor.codeLens": true
    }
  },
  "scripts": {
    "build": "node esbuild.mjs && vite build --config webview/vite.config.ts",
    "watch": "node esbuild.mjs --watch"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.90.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.1",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.8"
  }
}
